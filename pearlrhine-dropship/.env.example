# Öffentliche Adresse der App (für Feed-Links und Webhooks)
BASE_URL=https://dropship.example.com
PORT=3000

# --- Shopify ---
SHOPIFY_STORE=dein-shop.myshopify.com
SHOPIFY_API_VERSION=2026-07
# Variante A: vorhandenes Admin-API-Token
SHOPIFY_ADMIN_TOKEN=
# Variante B: Dev-Dashboard-App (Token wird automatisch per Client-Credentials geholt)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# HMAC-Secret für Webhooks (bei Variante B = Client Secret, kann leer bleiben)
SHOPIFY_WEBHOOK_SECRET=

# Welche Varianten in die Feeds kommen
PRODUCT_QUERY=tag:dropship AND product_status:active
# Nur Bestand dieser Locations zählen (kommagetrennte IDs), leer = alle
DROPSHIP_LOCATION_IDS=

# --- Bestandsregel: angezeigt = min(verfügbar − Puffer, Deckel) ---
STOCK_BUFFER=2
STOCK_CAP=20
STOCK_REFRESH_MINUTES=5
PRODUCT_REFRESH_MINUTES=60

# --- Preise ---
# B2B-Preisliste (Katalog) als EK-Quelle, leer = Metafeld dropship.ek bzw. Rabatt-Fallback
B2B_PRICE_LIST_ID=
DEFAULT_EK_DISCOUNT_PERCENT=30
TAX_RATE_PERCENT=19
PRICES_INCLUDE_TAX=true
# Dropship-Pauschale netto je Bestellung (0 = keine). Betrag kommt vom Vertrieb.
DROPSHIP_FEE_NET=0
CURRENCY=EUR
# Zahlungsziel für Händler ohne B2B-Firma. 0 = kein Template, Fallback paymentPending.
# Leer lassen und PAYMENT_TERMS_DAYS nutzen, oder eine Template-GID/ID direkt setzen.
PAYMENT_TERMS_DAYS=30
PAYMENT_TERMS_TEMPLATE_ID=

# Webhooks beim Start per Admin-API nachziehen.
# Bei einer Dev-Dashboard-App mit shopify.app.toml auf false lassen (sonst Doppellieferung).
REGISTER_WEBHOOKS=false

DELIVERY_TIME_TEXT=1–2 Werktage
ALLOWED_COUNTRIES=DE
OUR_RETURN_ADDRESS=PearlRhine Partners, Musterstraße 1, 50667 Köln

# --- Admin-Oberfläche (/admin) ---
ADMIN_USER=admin
ADMIN_PASSWORD=bitte-langes-passwort-setzen

# Testbetrieb mit Beispieldaten, ohne Shopify
MOCK_SHOPIFY=false
